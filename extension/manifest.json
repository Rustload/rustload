{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "short_name": "Rustload",
  "description": "__MSG_extDescription__",
  "version": "1.0.0",
  "default_locale": "en",
  "homepage_url": "https://github.com/rustload/rustload",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Rustload",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "permissions": ["activeTab", "alarms", "contextMenus", "notifications", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src http: https:; object-src 'none'; base-uri 'none'; form-action 'none'"
  },
  "protocol_handlers": [
    {
      "protocol": "magnet",
      "name": "Rustload",
      "uriTemplate": "/handler/magnet.html?uri=%s"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "rustload@rustload.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
